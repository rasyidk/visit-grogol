# ─────────────────────────────────────────────
#  VisitGrogol Backend — Environment Variables
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (MySQL)
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=5
DATABASE_URL="mysql://root:password@localhost:3306/visitgrogol?connection_limit=5"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="change-this-too-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
PUBLIC_BASE_URL=http://localhost:4000

# Seed superadmin (used by prisma/seed.ts)
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@visitgrogol.id
SEED_ADMIN_PASSWORD=Admin@12345
