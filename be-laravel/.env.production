APP_NAME="Visit Grogol Kaloka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.visitgrogolkaloka.com

# Pengaturan Akses dari Frontend (Penting untuk CORS & Authentication)
FRONTEND_URL=https://visitgrogolkaloka.com
SANCTUM_STATEFUL_DOMAINS=visitgrogolkaloka.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Sesuaikan dengan pengaturan Database di server Anda (VPS / Hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_produksi
DB_USERNAME=username_database
DB_PASSWORD=password_database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.visitgrogolkaloka.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Pengaturan Email (opsional, jika Anda menggunakan fitur kirim email)
MAIL_MAILER=smtp
MAIL_HOST=mail.visitgrogolkaloka.com
MAIL_PORT=465
MAIL_USERNAME=admin@visitgrogolkaloka.com
MAIL_PASSWORD=password_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@visitgrogolkaloka.com"
MAIL_FROM_NAME="${APP_NAME}"
